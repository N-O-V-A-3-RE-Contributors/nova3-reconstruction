# NOVA3 TEAMKIT: protect original game content and transient state
/analysis/
/analysis_db/
/Archive/
/originals/
/generated/
/research/
/build/
/.nova/
/.venv/
/.cache/
**/__pycache__/
**/.pytest_cache/
*.pyc
*.apk
*.obb
*.so
*.a
*.o
*.obj
*.rar
*.7z
*.zip
*.dex
*.png
*.jpg
*.jpeg
*.pvr
*.ktx
*.bdae
*.sqlite
*.db
*.gpr
*.rep
*.gbf
*.prefix
*.specimen
*.ppm
*.log
*.swp
*.tmp
.DS_Store
# NOVA3_WORKER_GENERATED_CACHE_IGNORE
**/__pycache__/
*.py[cod]
.pytest_cache/
.worktrees/

# Distributed worker loop: per-machine and per-run state is never committed.
/.local/
/.nova3-dsh-loop
/node_modules/
/package-lock.json

# Worktree symlinks to the private reference trees (a symlink is not a dir,
# so the trailing-slash patterns above do not cover them).
/originals
/Archive
/analysis
/research
/generated

# Local game materials supplied by the user (see materials/README.md)
/materials/apk/*
/materials/obb/*
!/materials/README.md

# A pre-released source tree dropped next to the checkout (reported, never committed)
/source-release/
/nova3-source/
/prerelease/
# Extracted pre-release source reference (proprietary; local analysis only)
/reference/
# Local derived source index (regenerate with tools/source_ref/index_source_reference.py)
/coordination/source_index.json
