    "command": "/home/jason/Projects/nova3_re/.venv/bin/python -c 'import json; p=\"coordination/evidence/functions-26c663650e19206f2d88d6.json\"; exec(chr(10).join(json.load(open(p))[\"reproduction\"][\"python_lines\"]))'",
    "python_lines": [
      "import hashlib, io, json, os, pathlib, random, struct, subprocess, tempfile",
      "import elftools, unicorn",
      "from elftools.elf.elffile import ELFFile",
      "from unicorn import Uc, UC_ARCH_ARM, UC_MODE_ARM, UC_HOOK_MEM_READ, UC_HOOK_MEM_WRITE",
      "from unicorn.arm_const import (UC_ARM_REG_R0, UC_ARM_REG_R1, UC_ARM_REG_R2,",
      "    UC_ARM_REG_R3, UC_ARM_REG_R4, UC_ARM_REG_R5, UC_ARM_REG_R6, UC_ARM_REG_R7,",
      "    UC_ARM_REG_R8, UC_ARM_REG_R9, UC_ARM_REG_R10, UC_ARM_REG_R11, UC_ARM_REG_R12,",
      "    UC_ARM_REG_SP, UC_ARM_REG_LR, UC_ARM_REG_PC)",
      "root = pathlib.Path.cwd()",
      "source = 'reconstruction/recovered/libNOVA3_neon/block_00710160.cpp'",
      "test = 'reconstruction/tests/recovered/libNOVA3_neon/block_00710160_test.cpp'",
      "reference = pathlib.Path(os.environ.get('NOVA3_REFERENCE',",
      "    '/home/jason/Projects/nova3_re/analysis/N.O.V.A.3_premium/lib/armeabi-v7a/libNOVA3_neon.so'))",
      "expected_hash = '84075223e7e7f833ebba98a46756ce4619fb909663cd0b961e440cc048abbaaf'",
      "reference_bytes = reference.read_bytes()",
      "assert hashlib.sha256(reference_bytes).hexdigest() == expected_hash",
      "functions = {'linkInstanceMaterial': (0x710160, 28), 'getVersion': (0x71017c, 20),",
      "             'getImage': (0x710318, 24), 'getMaterial': (0x71034c, 28)}",
      "def elf_functions(blob, original=False):",
      "    elf = ELFFile(io.BytesIO(blob))",
      "    assert elf['e_machine'] == 'EM_ARM' and elf.elfclass == 32 and elf.little_endian",
      "    symbols = list(elf.get_section_by_name('.symtab').iter_symbols())",
      "    result = {}",
      "    for name, (address, length) in functions.items():",
      "        if original:",
      "            symbol = next(s for s in symbols if s['st_info']['type'] == 'STT_FUNC'",
      "                          and s['st_value'] == address and s['st_size'] == length)",
      "        else:",
      "            symbol = next(s for s in symbols if s['st_info']['type'] == 'STT_FUNC'",
      "                          and name in s.name)",
      "        section = elf.get_section(symbol['st_shndx'])",
      "        offset = symbol['st_value'] - section['sh_addr']",
      "        code = section.data()[offset:offset + symbol['st_size']]",
      "        assert len(code) == symbol['st_size'] and symbol['st_value'] % 4 == 0",
      "        result[name] = (code, symbol.name)",
      "    if not original:",
      "        for section in elf.iter_sections():",
      "            if section.name in ('.rel.text', '.rela.text'):",
      "                assert section.num_relocations() == 0",
      "    return result",
      "original = elf_functions(reference_bytes, True)",
      "regs = [UC_ARM_REG_R0, UC_ARM_REG_R1, UC_ARM_REG_R2, UC_ARM_REG_R3,",
      "        UC_ARM_REG_R4, UC_ARM_REG_R5, UC_ARM_REG_R6, UC_ARM_REG_R7,",
      "        UC_ARM_REG_R8, UC_ARM_REG_R9, UC_ARM_REG_R10, UC_ARM_REG_R11, UC_ARM_REG_R12]",
      "base, data_size, stop = 0x02000000, 0x6000, 0x03000000",
      "obj, owner, header, collada, node = [base + n * 0x1000 for n in range(5)]",
      "def emulator(code):",
      "    uc = Uc(UC_ARCH_ARM, UC_MODE_ARM)",
      "    uc.mem_map(0x100000, 0x1000)",
      "    uc.mem_write(0x100000, code)",
      "    uc.mem_map(base, data_size)",
      "    uc.mem_map(stop, 0x1000)",
      "    trace = []",
      "    def memory(uc, access, address, size, value, _):",
      "        trace.append((access, address, size, value))",
      "    uc.hook_add(UC_HOOK_MEM_READ | UC_HOOK_MEM_WRITE, memory)",
      "    return uc, trace",
      "",
      "def invoke(machine, initial, index):",
      "    uc, trace = machine",
      "    uc.mem_write(base, initial)",
      "    trace.clear()",
      "    for n, reg in enumerate(regs):",
      "        uc.reg_write(reg, 0x12345000 + n)",
      "    uc.reg_write(UC_ARM_REG_R0, obj)",
      "    uc.reg_write(UC_ARM_REG_R1, index)",
      "    uc.reg_write(UC_ARM_REG_SP, stop + 0x800)",
      "    uc.reg_write(UC_ARM_REG_LR, stop)",
      "    uc.emu_start(0x100000, stop, count=32)",
      "    assert uc.reg_read(UC_ARM_REG_PC) == stop, 'instruction budget exhausted'",
      "    for n in range(4, 12):",
      "        assert uc.reg_read(regs[n]) == 0x12345000 + n",
      "    assert uc.reg_read(UC_ARM_REG_SP) == stop + 0x800",
      "    return uc.reg_read(UC_ARM_REG_R0), bytes(uc.mem_read(base, data_size)), list(trace)",
      "",
      "report = {'reference_sha256': expected_hash,",
      "          'source_sha256': hashlib.sha256((root/source).read_bytes()).hexdigest(),",
      "          'test_sha256': hashlib.sha256((root/test).read_bytes()).hexdigest(),",
      "          'dependencies': {'pyelftools': elftools.__version__, 'unicorn': unicorn.__version__},",
      "          'builds': [], 'arm': []}",
      "with tempfile.TemporaryDirectory(prefix='nova31-') as temporary:",
      "    tmp = pathlib.Path(temporary)",
      "    def run(command):",
      "        result = subprocess.run(command, capture_output=True, text=True)",
      "        report['builds'].append({'argv': command, 'exit_code': result.returncode,",
      "                                 'stdout': result.stdout.strip(), 'stderr': result.stderr.strip()})",
      "        assert result.returncode == 0, result.stderr",
      "    common = ['-std=c++17', '-Wall', '-Wextra', '-Wpedantic', '-Werror']",
      "    run(['c++', *common, '-O2', '-c', source, '-o', str(tmp/'host.o')])",
      "    run(['c++', *common, '-O2', test, '-o', str(tmp/'host_test')])",
      "    run([str(tmp/'host_test')])",
      "    run(['clang++', *common, '-O1', '-g', '-fsanitize=undefined',",
      "         '-fno-sanitize-recover=all', test, '-o', str(tmp/'ubsan_test')])",
      "    run([str(tmp/'ubsan_test')])",
      "    for compiler, target in [('arm-none-eabi-g++', ['-march=armv7-a']),",
      "                             ('clang++', ['--target=armv7a-none-eabi'])]:",
      "        output = tmp/(compiler + '.o')",
      "        flags = [*common, '-O2', '-marm', *target,",
      "                 '-ffreestanding', '-fno-exceptions', '-fno-rtti']",
      "        run([compiler, *flags, '-c', source, '-o', str(output)])",
      "        compiled = elf_functions(output.read_bytes())",
      "        variant = {'compiler': subprocess.check_output([compiler, '--version'], text=True).splitlines()[0],",
      "                   'flags': flags, 'object_sha256': hashlib.sha256(output.read_bytes()).hexdigest(),",
      "                   'functions': []}",
      "        for name, (address, size) in functions.items():",
      "            original_code, original_symbol = original[name]",
      "            compiled_code, compiled_symbol = compiled[name]",
      "            lhs, rhs = emulator(original_code), emulator(compiled_code)",
      "            rng = random.Random(address)",
      "            indices = [0, 1, 2, 7, 0xffffffff, 0xfffffffe, 0x80000000,",
      "                       0x7fffffff, 0x10000000, 0x40000000, 0x55555555, 0xaaaaaaaa]",
      "            indices += [rng.getrandbits(32) for _ in range(256)]",
      "            for number, index in enumerate(indices):",
      "                initial = bytearray(rng.randbytes(data_size))",
      "                def word(at, value):",
      "                    struct.pack_into('<I', initial, at-base, value & 0xffffffff)",
      "                word(obj, owner)",
      "                word(owner+0x10, header)",
      "                word(header+0x20, collada)",
      "                version = rng.getrandbits(32) if number % 5 else 0",
      "                image = rng.getrandbits(32) if number % 5 else 0",
      "                material = rng.getrandbits(32) if number % 5 else 0",
      "                head = [0, node, base+0x5000, rng.getrandbits(32)][number % 4]",
      "                word(collada, version)",
      "                word(collada+8, head)",
      "                word(collada+0x6c, image)",
      "                word(collada+0x7c, material)",
      "                word(node+0x40, rng.getrandbits(32))",
      "                argument = node if name == 'linkInstanceMaterial' else index",
      "                original_result = invoke(lhs, bytes(initial), argument)",
      "                compiled_result = invoke(rhs, bytes(initial), argument)",
      "                # Compare every data byte and the ordered read/write trace.",
      "                assert original_result[1:] == compiled_result[1:], (name, number)",
      "                if name != 'linkInstanceMaterial':",
      "                    assert original_result[0] == compiled_result[0], (name, number)",
      "                    expected_return = {'getVersion': version,",
      "                        'getImage': (image + index*16) & 0xffffffff,",
      "                        'getMaterial': (material + index*36) & 0xffffffff}[name]",
      "                    assert original_result[0] == expected_return",
      "                    assert original_result[1] == bytes(initial)",
      "                else:",
      "                    expected = bytearray(initial)",
      "                    struct.pack_into('<I', expected, node-base+0x40, head)",
      "                    struct.pack_into('<I', expected, collada-base+8, node)",
      "                    assert original_result[1] == bytes(expected)",
      "            variant['functions'].append({'name': name, 'address': f'0x{address:08x}',",
      "                'original_symbol': original_symbol, 'compiled_symbol': compiled_symbol,",
      "                'reference_size': size, 'compiled_size': len(compiled_code),",
      "                'reference_code_sha256': hashlib.sha256(original_code).hexdigest(),",
      "                'compiled_code_sha256': hashlib.sha256(compiled_code).hexdigest(),",
      "                'matching': 'MATCHED' if original_code == compiled_code else 'NOT MATCHED',",
      "                'comparison': 'Complete ELF STT_FUNC bytes; exact equality; no relocation masking',",
      "                'oracle_cases': len(indices), 'oracle_result': 'PASS'})",
      "        report['arm'].append(variant)",
      "print(json.dumps(report, indent=2))"
    ]
  },
