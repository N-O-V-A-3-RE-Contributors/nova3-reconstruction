# NOVA3 worker profile — user patch layer.
#
# Generated by tools/dsh_loop (installer) for THIS machine only. It contains no
# secrets: the API key is read through the credential reference below, which
# resolves to the environment variable the launcher exports for the child
# process. Edit the model route/ids in ~/.config/nova3/dsh-loop.json and re-run
# the installer instead of hand-editing this file.

# --- Model route -----------------------------------------------------------
# Route name stays `openrouter`; model ids stay bare so an OpenRouter key (or a
# DeepSeek direct key with the openai-completions protocol) both work.
- id: llm-pi-ai
  name: "@deepseek-ai/dsh-llm-pi-ai"
  config:
    providers:
      openrouter:
        displayName: "NOVA3 model route"
        api: openai-completions
        baseURL: "__BASE_URL__"
        apiKeyEnv: __API_KEY_ENV__
        models:
          - id: __MODEL_ID__
            name: "__MODEL_NAME__"
            contextWindow: __CONTEXT_WINDOW__
            maxTokens: __MAX_TOKENS__
            input:
              - text

- id: agent-default-model
  name: "@deepseek-ai/dsh-agent-default-model"
  config:
    provider: openrouter
    model: __MODEL_ID__

# --- Autonomy -----------------------------------------------------------------
# The worker must finish its own work without waiting for a human: approval
# prompts are off and the file sandbox matches the permission preset below.
# Everything still runs as the invoking OS user; nothing here grants root.
- id: permission
  name: "@deepseek-ai/dsh-permission-presets"
  config:
    presets:
      read-only:
        sandbox: read-only
        approval: ask
      workspace-write:
        sandbox: workspace-write
        approval: ask
      danger-full-access:
        sandbox: danger-full-access
        approval: never
    defaultPreset: danger-full-access

- id: approval
  name: "@deepseek-ai/dsh-user-approval"
  config:
    mode: never

- id: sandbox-policy
  name: "@deepseek-ai/dsh-sandbox-policy"
  config:
    mode: danger-full-access

# A worker that is allowed to plan but not act produces nothing; the write
# tools are the point of the profile. `native` is the plain tool surface; the
# experimental PTC mode is opt-in through DSH_TOOLS_MODE on the launching env.
- id: tools
  name: "@deepseek-ai/dsh-tools"
  config:
    mode: !!js process.env.DSH_TOOLS_MODE || 'native'

# --- Web search/fetch ----------------------------------------------------------
# These default to the DeepSeek key; this machine's route has none. Keep the
# opt-in search plugins off so a missing unrelated key cannot abort a run.
- id: web-search-deepseek
  name: "@deepseek-ai/dsh-web-search-deepseek"
  disabled: true

- id: web-deepseek-api
  name: "@deepseek-ai/dsh-web-deepseek-api"
  disabled: true

# --- Persona -------------------------------------------------------------------
- id: system-prompt
  name: "@deepseek-ai/dsh-system-prompt"
  config:
    personaPrefix: >-
      You are a coding agent powered by the {{model}} model.

# --- Session titles --------------------------------------------------------------
# Without an explicit route the title provider falls back to the first model
# request, which is our route; pin it so a title request can never reach an
# unconfigured default provider.
- id: session-title-llm
  name: "@deepseek-ai/dsh-session-title-first-prompt-llm"
  config:
    targetWords: 5
    targetCjkCharacters: 10
    maxInputBytes: 4096
    maxOutputTokens: 512
    timeoutMs: 30000
    provider: openrouter
    model: __MODEL_ID__
