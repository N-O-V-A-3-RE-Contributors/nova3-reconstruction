# NOVA3 autopilot: act on the owner's persistent switch. One timer tick = at
# most two approvals and two merges; the switch itself has no expiry and no
# task budget. Only depleted credit pauses it (temporarily, automatically).
# Nothing here can approve outside the safe source paths or extend the switch.
[Unit]
Description=NOVA3 autopilot (owner-enabled, no expiry)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/nova3_re
Environment=PYTHONPATH=%h/Projects/nova3_re
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=%h
ExecStart=/usr/bin/python3 -m nova3_team.autopilot run --repo N-O-V-A-3-RE-Contributors/nova3-reconstruction
TimeoutStartSec=900
Nice=10
